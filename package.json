  "license": "MIT",
  "description": "0 dependencies event-loop blocking synchronus sleep modelled after atomic-sleep.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nktnet1/slync"
  },
  "version": "1.0.2",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
